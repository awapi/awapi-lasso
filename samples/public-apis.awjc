awapiLasso: "1.0"
kind: Collection
metadata:
  id: col_public_apis_01
  name: Public Web APIs
  description: Ready-to-run GET & GraphQL requests against public APIs (HTTPBin, JSONPlaceholder, GitHub, and Countries GraphQL)
  createdAt: 2026-10-25T00:00:00Z
  updatedAt: 2026-10-25T00:00:00Z
defaults:
  timeoutMs: 30000
  followRedirects: true
  verifySsl: true
  headers:
    - key: Accept
      value: application/json
      enabled: true
    - key: User-Agent
      value: AwapiLasso/1.0
      enabled: true
  auth:
    type: none
variables:
  - key: githubOwner
    value: electron
    enabled: true
    description: GitHub organization or username
  - key: githubRepo
    value: electron
    enabled: true
    description: GitHub repository name
  - key: postId
    value: "1"
    enabled: true
    description: Sample post ID for JSONPlaceholder
activeEnvironment: public
environments:
  - id: env_public
    name: public
    color: "#3b82f6"
    variables:
      - key: httpbinUrl
        value: https://httpbin.org
        enabled: true
      - key: jsonPlaceholderUrl
        value: https://jsonplaceholder.typicode.com
        enabled: true
      - key: githubApiUrl
        value: https://api.github.com
        enabled: true
      - key: countriesGraphqlUrl
        value: https://countries.trevorblades.com/graphql
        enabled: true
items:
  - kind: folder
    id: fld_public_rest
    name: Public REST APIs
    description: Public read-only GET endpoints requiring no authentication
    auth:
      type: inherit
    headers: []
    items:
      - kind: request
        id: req_httpbin_get
        name: HTTPBin Inspect GET
        protocol: http
        method: GET
        url: "{{httpbinUrl}}/get"
        queryParams:
          - key: client
            value: awapi-lasso
            enabled: true
          - key: requestId
            value: "{{$uuid}}"
            enabled: true
        auth:
          type: none
        body:
          mode: none
        assertions:
          - target: status
            operator: equals
            expected: 200
          - target: jsonpath
            path: $.args.client
            operator: equals
            expected: awapi-lasso
      - kind: request
        id: req_jsonplaceholder_posts
        name: JSONPlaceholder List Posts
        protocol: http
        method: GET
        url: "{{jsonPlaceholderUrl}}/posts"
        queryParams:
          - key: _limit
            value: "5"
            enabled: true
        auth:
          type: none
        body:
          mode: none
        assertions:
          - target: status
            operator: equals
            expected: 200
          - target: jsonpath
            path: $
            operator: isArray
      - kind: request
        id: req_jsonplaceholder_post_by_id
        name: JSONPlaceholder Get Post by ID
        protocol: http
        method: GET
        url: "{{jsonPlaceholderUrl}}/posts/:id"
        pathParams:
          - key: id
            value: "{{postId}}"
        auth:
          type: none
        body:
          mode: none
        assertions:
          - target: status
            operator: equals
            expected: 200
          - target: jsonpath
            path: $.id
            operator: equals
            expected: 1
      - kind: request
        id: req_github_repo
        name: GitHub Repository Info
        protocol: http
        method: GET
        url: "{{githubApiUrl}}/repos/:owner/:repo"
        pathParams:
          - key: owner
            value: "{{githubOwner}}"
          - key: repo
            value: "{{githubRepo}}"
        auth:
          type: none
        body:
          mode: none
        assertions:
          - target: status
            operator: equals
            expected: 200
          - target: jsonpath
            path: $.full_name
            operator: contains
            expected: electron
  - kind: folder
    id: fld_public_graphql
    name: Public GraphQL APIs
    description: Public GraphQL endpoint with live introspection enabled
    items:
      - kind: request
        id: req_countries_gql
        name: Query Country Details (Countries GraphQL)
        protocol: graphql
        method: POST
        url: "{{countriesGraphqlUrl}}"
        auth:
          type: none
        graphql:
          operationName: GetCountry
          schemaSource:
            mode: introspect
            autoIntrospectOnOpen: true
            localSchemaPath: ""
          query: |
            query GetCountry($code: ID!) {
              country(code: $code) {
                code
                name
                native
                capital
                currency
                emoji
                continent {
                  code
                  name
                }
              }
            }
          variables: |
            {
              "code": "CA"
            }
        assertions:
          - target: status
            operator: equals
            expected: 200
          - target: jsonpath
            path: $.data.country.code
            operator: equals
            expected: CA
