            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/orders/:orderId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiVersion}}",
                "orders",
                ":orderId"
              ],
              "variable": [
                {
                  "key": "orderId",
                  "value": "{{lastOrderId}}",
                  "description": "Order to act on (set by Create Order)"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Inventory GraphQL API",
      "item": [
        {
          "name": "Query Warehouse Stock",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query GetWarehouseStock($sku: ID!, $warehouseId: ID) {\n  inventoryItem(sku: $sku, warehouseId: $warehouseId) {\n    sku\n    name\n    availableQuantity\n    inStock\n    warehouse {\n      id\n      name\n    }\n  }\n}\n",
                "variables": "{\n  \"sku\": \"SKU-100\",\n  \"warehouseId\": \"WH-EAST-01\"\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            }
          }
        },
        {
          "name": "Mutate Inventory Stock",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation AdjustStock($sku: ID!, $delta: Int!) {\n  adjustInventoryStock(sku: $sku, delta: $delta) {\n    sku\n    availableQuantity\n  }\n}\n",
                "variables": "{\n  \"sku\": \"SKU-200\",\n  \"delta\": 5\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            }
          }
        }
      ]
    },
