            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"shipped\",\n  \"notes\": \"Dispatched via express carrier\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/orders/:orderId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiVersion}}",
                "orders",
                ":orderId"
              ],
              "variable": [
                {
                  "key": "orderId",
                  "value": "{{lastOrderId}}",
                  "description": "Order to act on (set by Create Order)"
                }
              ]
            }
          }
        },
        {
          "name": "Update Order Status (form-urlencoded)",
          "request": {
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "status",
                  "value": "delivered"
                },
                {
                  "key": "notes",
                  "value": "Left at reception"
                },
                {
                  "key": "signature",
                  "value": "n/a",
                  "disabled": true
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/orders/:orderId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiVersion}}",
                "orders",
                ":orderId"
              ],
              "variable": [
                {
                  "key": "orderId",
                  "value": "{{lastOrderId}}",
                  "description": "Order to act on (set by Create Order)"
                }
              ]
            }
          }
        },
        {
          "name": "Upload Invoice Attachment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(201);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "documentType",
                  "value": "invoice",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": "./samples/invoice.pdf"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/orders/:orderId/attachments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiVersion}}",
                "orders",
                ":orderId",
                "attachments"
              ],
              "variable": [
                {
                  "key": "orderId",
                  "value": "{{lastOrderId}}",
                  "description": "Order to act on (set by Create Order)"
                }
              ]
            }
          }
        },
        {
          "name": "Check Orders Headers",
          "request": {
            "method": "HEAD",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiVersion}}",
                "orders"
              ]
            }
          }
        },
        {
          "name": "Delete Order",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Pre-request scripts are not imported (reported after import)",
                  "pm.variables.set(\"deletedAt\", Date.now());"
                ]
