  "item": [
    {
      "name": "Orders REST API",
      "description": "CRUD endpoints for customer orders",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Service is up\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiVersion}}",
                "health"
              ]
            }
          }
        },
        {
          "name": "List Orders",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Debug",
                "value": "1",
                "disabled": true,
                "description": "Enable for verbose server logs"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/orders?status=pending&limit=25",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiVersion}}",
                "orders"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "pending"
                },
                {
                  "key": "limit",
                  "value": "25"
                },
                {
                  "key": "customerId",
                  "value": "cust_901",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Create Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Order created\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"lastOrderId\", json.data.id);",
                  "pm.environment.set(\"orderLocation\", pm.response.headers.get(\"Location\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Request-Id",
                "value": "{{$guid}}"
              }
            ],
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "grant_type",
                  "value": "password_credentials"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "{{authBaseUrl}}/oauth/token"
                },
                {
                  "key": "clientId",
                  "value": "{{clientId}}"
                },
                {
                  "key": "clientSecret",
                  "value": "{{clientSecret}}"
                },
                {
                  "key": "username",
                  "value": "{{apiUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{apiPassword}}"
                },
                {
                  "key": "scope",
                  "value": "openid profile orders:admin"
                },
                {
                  "key": "client_authentication",
                  "value": "body"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"cust_901\",\n  \"currency\": \"USD\",\n  \"requestedAt\": \"{{$isoTimestamp}}\",\n  \"contactName\": \"{{$randomFullName}}\",\n  \"items\": [\n    {\n      \"sku\": \"SKU-100\",\n      \"quantity\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiVersion}}",
                "orders"
              ]
            }
          }
        },
        {
          "name": "Get Order by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.expect(pm.response.code).to.eql(200);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/orders/:orderId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiVersion}}",
                "orders",
                ":orderId"
              ],
              "variable": [
                {
                  "key": "orderId",
                  "value": "{{lastOrderId}}",
                  "description": "Order to act on (set by Create Order)"
                }
              ]
            }
          }
        },
        {
          "name": "Update Order Status (JSON)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
